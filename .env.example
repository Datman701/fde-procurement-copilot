# Local mock service (vendor / security status endpoint)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: gemini | openai | openrouter | groq | ollama
# `gemini`, `openrouter` and `groq` are all reached through the same
# OpenAI-compatible adapter; only the base URL differs.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Optional overrides (auto-detected per provider when omitted)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=4
# LLM_REQUESTS_PER_MINUTE=10
# LLM_MAX_CALLS_PER_RUN=12
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=low

# Eval / reproducibility
# LLM_CACHE_PATH=eval/cache/llm_cache.json
# VENDOR_RISK_TRANSPORT=http|inprocess
